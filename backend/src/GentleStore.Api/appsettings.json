{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "GentleStore",
    "Audience": "GentleStoreClients",
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS",
    "ExpiryMinutes": 480
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:5174" ]
  },
  "Storefront": {
    "Url": "http://localhost:5174",
    "InviteExpiryDays": 14,
    "SessionCookie": {
      "NamePrefix": "gs_sf",
      "SameSite": "Lax",
      "Domain": null,
      "Secure": null,
      "MaxAgeDays": 400
    }
  },
  "Seed": {
    "SuperAdminEmail": "admin@gentlestore.local",
    "SuperAdminPassword": "Admin123!",
    "DemoStoreOwnerPassword": "Owner123!"
  }
}
