{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Payments": {
    "IdempotencyKeyLifetimeHours": 24,
    "Outbox": {
      "Enabled": true,
      "PollSeconds": 5,
      "BatchSize": 50,
      "MaxAttempts": 12,
      "BaseBackoffSeconds": 10,
      "MaxBackoffSeconds": 3600,
      "TimeoutSeconds": 10
    },
    "Reconciler": {
      "Enabled": true,
      "PollSeconds": 60,
      "BatchSize": 50,
      "StalePaymentMinutes": 15,
      "AbandonAfterHours": 24
    },
    "Callbacks": {
      "SignatureHeader": "X-Payment-Signature",
      "SigningSecret": null
    }
  },
  "InternalAccess": {
    "HeaderName": "X-Internal-Key",
    "Keys": []
  },
  "Gateways": {
  }
}
