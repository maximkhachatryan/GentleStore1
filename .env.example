# Copy to `.env` on the server and fill in real values. Never commit `.env`.

# --- Database ---
POSTGRES_DB=gentlestore
POSTGRES_USER=gentlestore
POSTGRES_PASSWORD=change-me-strong-db-password

# --- JWT (must be >= 32 characters; generate a fresh random value) ---
# e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars

# --- Public domains (DNS A-records must point to this server) ---
STOREFRONT_DOMAIN=example.com
CONSOLE_DOMAIN=console.example.com
API_DOMAIN=api.example.com

# --- Email for Let's Encrypt certificate notifications ---
ACME_EMAIL=admin@example.com

# --- Initial super admin (created on first boot) ---
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-strong-admin-password

# --- Seed demo stores/products? Keep false in production. ---
SEED_DEMO_DATA=false
