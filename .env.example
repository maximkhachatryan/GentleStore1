# Copy to `.env` on the server and fill in real values. Never commit `.env`.

# --- Database ---
POSTGRES_DB=gentlestore
POSTGRES_USER=gentlestore
POSTGRES_PASSWORD=change-me-strong-db-password

# --- JWT (must be >= 32 characters; generate a fresh random value) ---
# e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars

# --- Public domains (DNS A-records must point to this server) ---
STOREFRONT_DOMAIN=example.com
CONSOLE_DOMAIN=console.example.com
API_DOMAIN=api.example.com

# --- Email for Let's Encrypt certificate notifications ---
ACME_EMAIL=admin@example.com

# --- Initial super admin (created on first boot) ---
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-strong-admin-password

# --- Seed demo stores/products? Keep false in production. ---
SEED_DEMO_DATA=false

# --- Invite links (for stores set to "invited customers only") ---
# How long an invite link stays usable before it has to be regenerated.
INVITE_EXPIRY_DAYS=14

# --- Telegram order alerts ---
# Create a bot with @BotFather in Telegram (/newbot) and paste what it gives you.
# Leave both empty to switch Telegram alerts off; the in-console alerts work either way.
# The token is a secret: anyone holding it can send messages as your bot.
TELEGRAM_BOT_TOKEN=
# Without the "@", e.g. GentleStoreAlertsBot
TELEGRAM_BOT_USERNAME=

# --- PaymentService ---
# Its own database, on the same Postgres instance. Created automatically on first boot.
POSTGRES_PAYMENTS_DB=gentlestore_payments

# Shared secret GentleStore presents to the payment service (header: X-Internal-Key).
# Read by BOTH services: the payment service accepts it, the API sends it.
# Leave empty to rely on network isolation alone, which is the default while the service has
# no public host. Set it before giving the payment service a public hostname for webhooks.
# e.g. `openssl rand -base64 32`
PAYMENTS_INTERNAL_KEY=

# Signs the payment status callbacks posted back to the API, so GentleStore can tell a genuine
# "this order is paid" from anything else on the network that can reach the endpoint.
# e.g. `openssl rand -base64 32`
PAYMENTS_CALLBACK_SECRET=

# Public hostname for the payment service. Needed only because Paynet posts webhooks from the
# public internet. Leave empty to keep the service reachable from the compose network only —
# payments then resolve by polling instead of by webhook.
# SETTING THIS ALSO PUBLISHES /api/payments, so set PAYMENTS_INTERNAL_KEY above at the same time.
PAYMENTS_DOMAIN=

# The same host as a URL: https://<PAYMENTS_DOMAIN>. This is what gateways are told to post to
# ({PAYMENTS_PUBLIC_URL}/api/webhooks/{gatewayKey}). Leave empty to disable webhooks entirely.
PAYMENTS_PUBLIC_URL=

# --- Paynet (paynet.am) ---
# Registers paynet-arca, paynet-idram and paynet-telcell as gateways.
PAYNET_ENABLED=false

# From your Paynet dashboard. A test key runs payments through their sandbox — no real money
# moves — so start with one. Live and test are chosen by the key, not by a different URL.
PAYNET_API_KEY=

# Used to verify the HMAC-SHA256 signature on inbound Paynet webhooks. Without it every webhook
# is rejected, which is the correct failure but an easy one to misread as Paynet being broken.
PAYNET_WEBHOOK_SECRET=

# One of your verified domains in Paynet. Sent on server-to-server calls, which carry no Origin.
PAYNET_DOMAIN=
